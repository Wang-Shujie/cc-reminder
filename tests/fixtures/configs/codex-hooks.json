{
  "description": "foreign trusted file owned by the user",
  "hooks": {
    "Stop": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/foreign-stop-handler.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "'/Users/fixtures/.cc-reminder/bin/cc-reminder-hook' '--owner' 'cc-reminder' '--agent' 'codex' '--event' 'Stop'", "commandWindows": "/Users/fixtures/.cc-reminder/bin/cc-reminder-hook --owner cc-reminder --agent codex --event Stop", "timeout": 1 }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "/tmp/foreign-owner-cc-reminder-lookalike --owner cc-reminder --agent codex --event Stop --extra-junk", "timeout": 2 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/foreign-permission.sh", "timeout": 3 }
        ]
      }
    ]
  }
}
