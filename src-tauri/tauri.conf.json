{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Reminder",
  "version": "2.0.0",
  "identifier": "com.ccreminder.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Reminder",
        "width": 976,
        "height": 672,
        "minWidth": 976,
        "minHeight": 672
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/capabilities/claude-code-2.1.218.json",
      "resources/capabilities/codex-0.145.0.json",
      "resources/helper-manifest.json",
      "resources/bin/cc-reminder-hook",
      "resources/bin/cc-reminder-hook.exe"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.digicert.com",
      "tsp": true,
      "nsis": {
        "installMode": "currentUser",
        "template": "../scripts/nsis/installer.nsi",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQzY3N0I2NDVENUM2NjAKUldSZ3h0VkZ0bmZHbWthSGhCTVdnSUpZdFQ5azJDdGVZNXhnQTRvT3c3TnJXRW5hTUpOVlJpcW4K",
      "endpoints": [
        "https://github.com/Wang-Shujie/cc-reminder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
